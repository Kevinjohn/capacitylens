{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    /* DOM.Iterable is listed explicitly, not because the compile currently needs it: this
       TypeScript folds the iterable NodeList declarations into lib.dom.d.ts, so
       `for (const el of document.querySelectorAll(…))` in src/lib/shortcutGuards.ts type-checks
       under plain DOM today. Naming the lib states the requirement the source actually has
       rather than leaning on where a given TypeScript release happens to declare it. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Paraglide (inlang) i18n (P1.5.1) emits its message/runtime modules as .js with JSDoc types
       (src/paraglide, generated + gitignored). allowJs lets tsc READ those JSDoc types — without it
       the imports resolve to `any` and the whole compile-time-safety point (a removed message key
       becoming a tsc error) is lost. The only .js under src is this generated output; checkJs stays
       off so the generated code is type-PROVIDING, not itself type-checked. */
    "allowJs": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias (shadcn @/* → src/*). No baseUrl: it's deprecated in TS 6 (TS5101);
       under moduleResolution "bundler", `paths` resolves relative to this config. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "shared/src"],
  // These filesystem-backed tests are type-checked under tsconfig.node.json (which carries
  // `"types": ["node"]`) instead, keeping Node globals out of this browser-only program.
  "exclude": [
    "shared/src/packageExports.test.ts",
    "src/auth/authErrorInit.test.ts",
    "src/bundleBudgetGate.test.ts",
    "src/cryptoInventoryGate.test.ts",
    "src/data/offlineWorker.test.ts",
    "src/e2eOidcHarness.test.ts",
    "src/playwrightFixturesPolicy.test.ts",
    "src/pnpmSpawn.test.ts",
    "src/serveDist.test.ts",
    "src/test/docs-lightbox.test.ts",
    "src/test/privacy-posture.test.ts"
  ]
}
