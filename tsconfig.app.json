{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    // DOM.Iterable makes the browser iterable contract explicit instead of relying on a particular TypeScript library layout.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Read the generated Paraglide JavaScript’s JSDoc types so message-key changes remain type errors.
    // checkJs stays off because generated modules supply types rather than source requiring review.
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    // paths resolve relative to this config in bundler mode; baseUrl is deprecated in TypeScript 6.
    "paths": { "@/*": ["./src/*"] },

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "shared/src"],
  // These filesystem-backed tests are type-checked under tsconfig.node.json (which carries
  // `"types": ["node"]`) instead, keeping Node globals out of this browser-only program.
  "exclude": [
    "shared/src/packageExports.test.ts",
    "src/auth/authErrorInit.test.ts",
    "src/bundleBudgetGate.test.ts",
    "src/cryptoInventoryGate.test.ts",
    "src/data/offlineWorker.test.ts",
    "src/playwrightFixturesPolicy.test.ts",
    "src/pnpmSpawn.test.ts",
    "src/serve-dist.test.ts",
    "src/test/docs-lightbox.test.ts",
    "src/test/privacy-posture.test.ts"
  ]
}
