# CapacityLens behind Caddy. Add this block to /etc/caddy/Caddyfile with your own hostname, then
# run: sudo systemctl reload caddy
# Caddy obtains and renews the certificate itself and overwrites the forwarded headers the server
# trusts. The server serves the web app, so one reverse_proxy line covers the whole site.
#
# Caddy writes no access log unless a `log` directive is added. If you add one, exclude
# /invitation/*, /reset-password/* and /api/invitations/*: those request lines carry
# single-use sign-in secrets.
capacity.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
}
