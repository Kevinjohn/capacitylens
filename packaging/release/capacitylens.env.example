# Keep this file private and outside the release directory.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
APP_URL=https://capacity.example.com
# Generate with `node ace.js generate:key --show` from backend, then paste the value here.
APP_KEY=
SESSION_DRIVER=database
# Password authentication is enabled; set every blank secret before starting.
CAPACITYLENS_MODE=password-only
CAPACITYLENS_SECRET=
CAPACITYLENS_PUBLIC_URL=https://capacity.example.com
# Random secret (at least 32 characters) used once in the browser's first-run setup.
CAPACITYLENS_SETUP_TOKEN=
# Open access remains disabled in production.
CAPACITYLENS_ALLOW_OPEN_IN_PRODUCTION=0
CAPACITYLENS_AUDIT=on
# The bundled Caddy and nginx examples overwrite the client address header. Trusting it gives each
# browser its own rate-limit budget; keep HOST on loopback so only that proxy can reach the server.
CAPACITYLENS_TRUST_PROXY_HEADERS=1
CAPACITYLENS_DB=/var/lib/capacitylens/capacitylens.db
CAPACITYLENS_BACKUP_DIR=/var/lib/capacitylens/backups
# Online snapshot at startup and every 24 hours; retain this many completed snapshots.
CAPACITYLENS_BACKUP_KEEP=48
