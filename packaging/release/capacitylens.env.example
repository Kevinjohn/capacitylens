# CapacityLens server settings. Fill in the three empty lines; everything else has a default.
# The server refuses to start while any of the three is empty, and names the one that is missing.
NODE_ENV=production
# The address people open in their browser, for example https://capacity.example.com
SMALLSASS_ACCOUNT_PUBLIC_URL=
# Paste the output of: openssl rand -base64 48
SMALLSASS_ACCOUNT_SECRET=
# Paste a second, different output of the same command. You enter it once, to create the Owner.
SMALLSASS_ACCOUNT_SETUP_TOKEN=
# The database file, created on first start. Its folder must exist and be writable by the server.
CAPACITYLENS_DB=/var/lib/capacitylens/capacitylens.db
# Sign-in defaults to email and password under NODE_ENV=production, as if this line were set:
# SMALLSASS_ACCOUNT_MODE=password-only
