# CapacityLens server settings. `node server/dist/index.mjs init` prints these settings with the three
# empty lines filled in (INSTALL.md step 3); everything else has a default.
# The server refuses to start while any of the three is empty, and names the one that is missing.
NODE_ENV=production
# The address people open in their browser, for example https://capacity.example.com
CAPACITYLENS_PUBLIC_URL=
# A long random value that signs sessions. `init` generates it.
CAPACITYLENS_SECRET=
# A second, different random value, also generated by `init`. You enter it once, to create the Owner.
CAPACITYLENS_SETUP_TOKEN=
# The database file, created on first start. Its folder must exist and be writable by the server.
CAPACITYLENS_DB=/var/lib/capacitylens/capacitylens.db
# Sign-in defaults to email and password under NODE_ENV=production, as if this line were set:
# CAPACITYLENS_MODE=password-only
