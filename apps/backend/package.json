{
  "name": "@capacitylens/backend",
  "version": "0.75.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "start:e2e": "node scripts/e2e-server.mjs db",
    "start:auth-e2e": "node scripts/e2e-server.mjs auth",
    "codegen": "node ace codegen",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -b tsconfig.client.json"
  },
  "imports": {
    "#auth/*": "./app/auth/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/bodyparser": "11.0.5",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/logger": "7.1.1",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "~26.6.2",
    "eslint": "~10.14.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/bouncer": "4.0.1",
    "@adonisjs/core": "7.6.0",
    "@adonisjs/cors": "3.0.0",
    "@adonisjs/limiter": "3.0.1",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/mail": "10.4.0",
    "@adonisjs/session": "8.3.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@capacitylens/shared": "workspace:*",
    "@kevinjohn/adonisjs-access-control": "https://github.com/Kevinjohn/oss-adonisjs-access-control/releases/download/v0.1.7/kevinjohn-adonisjs-access-control-0.1.7.tgz",
    "@kevinjohn/adonisjs-account-kit": "https://github.com/Kevinjohn/oss-adonisjs-account-kit/releases/download/v0.3.4/kevinjohn-adonisjs-account-kit-0.3.4.tgz",
    "@kevinjohn/adonisjs-confirm-action-with-password": "https://github.com/Kevinjohn/oss-adonisjs-confirm-action-with-password/releases/download/v0.1.1/kevinjohn-adonisjs-confirm-action-with-password-0.1.1.tgz",
    "@kevinjohn/adonisjs-duplicate-request-guard": "https://github.com/Kevinjohn/oss-adonisjs-duplicate-request-guard/releases/download/v0.1.0/kevinjohn-adonisjs-duplicate-request-guard-0.1.0.tgz",
    "@kevinjohn/adonisjs-masquerade": "https://github.com/Kevinjohn/oss-adonisjs-masquerade/releases/download/v0.2.8/kevinjohn-adonisjs-masquerade-0.2.8.tgz",
    "@kevinjohn/adonisjs-lucid-checked-columns": "https://github.com/Kevinjohn/oss-adonisjs-lucid-checked-columns/releases/download/v0.1.0/kevinjohn-adonisjs-lucid-checked-columns-0.1.0.tgz",
    "@kevinjohn/adonisjs-lucid-soft-delete": "https://github.com/Kevinjohn/oss-adonisjs-lucid-soft-delete/releases/download/v0.1.7/kevinjohn-adonisjs-lucid-soft-delete-0.1.7.tgz",
    "@kevinjohn/adonisjs-origin-guard": "https://github.com/Kevinjohn/oss-adonisjs-origin-guard/releases/download/v0.1.0/kevinjohn-adonisjs-origin-guard-0.1.0.tgz",
    "@kevinjohn/adonisjs-sqlite-backup": "https://github.com/Kevinjohn/oss-adonisjs-sqlite-backup/releases/download/v0.2.0/kevinjohn-adonisjs-sqlite-backup-0.2.0.tgz",
    "@tuyau/core": "1.3.0",
    "@vinejs/vine": "4.4.0",
    "better-sqlite3": "13.0.3",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
