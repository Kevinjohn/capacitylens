# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Generate with: node ace.js generate:key --show
APP_KEY=
APP_URL=http://${HOST}:${PORT}

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CAPACITYLENS_CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Public origin, database and backups
#--------------------------------------------------------------------
# Origin users reach; when unset, APP_URL is used. Production requires HTTPS.
# CAPACITYLENS_PUBLIC_URL=
# SQLite database file; when unset, tmp/db.sqlite3.
# CAPACITYLENS_DB=
# Directory for the startup and 24-hourly online backups; when unset, scheduled backups are off.
# CAPACITYLENS_BACKUP_DIR=
# Completed backups to keep; when unset, 48.
# CAPACITYLENS_BACKUP_KEEP=

#--------------------------------------------------------------------
# Email (invitations, address confirmation and password resets)
#--------------------------------------------------------------------
# CAPACITYLENS_MAIL_HOST=
# CAPACITYLENS_MAIL_PORT=
# CAPACITYLENS_MAIL_USER=
# CAPACITYLENS_MAIL_PASSWORD=
# CAPACITYLENS_MAIL_FROM=

#--------------------------------------------------------------------
# Admission
#--------------------------------------------------------------------
# Comma-separated address domains an invited person must use, for example example.com,example.org.
# CAPACITYLENS_ALLOWED_EMAIL_DOMAINS=
# true allows open registration; each identity still needs an Owner or Admin approval.
# CAPACITYLENS_ALLOW_OPEN_SIGNUP=

#--------------------------------------------------------------------
# Requests and logging
#--------------------------------------------------------------------
# Requests per client per minute; when unset, 300 in production and off otherwise.
# CAPACITYLENS_RATE_LIMIT=
# true or 1 trusts a loopback proxy's client address header; private also trusts private networks.
# CAPACITYLENS_TRUST_PROXY_HEADERS=
# 1 logs request completions and password sign-in outcomes.
# CAPACITYLENS_LOG=

#--------------------------------------------------------------------
# Local development and tests
#--------------------------------------------------------------------
# true creates the local admin@admin.admin identity at startup; refused in production.
# CAPACITYLENS_CREATE_ADMIN_ADMIN=
# Password for that local identity, 15 to 128 characters.
# CAPACITYLENS_BOOTSTRAP_ADMIN_PASSWORD=
# Set by scripts/dev/dev-fullstack.mjs: extra web origins a development server allows.
# CAPACITYLENS_DEV_WEB_ORIGINS=
# Set by apps/backend/scripts/e2e-server.mjs: replaces today's date (YYYY-MM-DD).
# CAPACITYLENS_FIXED_TODAY=
# Set by bin/test.ts and the e2e server: enables the reset harness; refused in production.
# CAPACITYLENS_ALLOW_RESET=
# Set by bin/test.ts: the test server's HTTP port.
# CAPACITYLENS_TEST_HTTP_PORT=
