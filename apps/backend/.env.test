# Fixed values for the test runner, loaded when NODE_ENV=test. A variable already set in the
# shell wins over this file, except the three CAPACITYLENS_ values below, which bin/test.ts drops
# from the shell. Port-lane-computed values and an ephemeral APP_KEY stay in bin/test.ts.
HOST=127.0.0.1
LOG_LEVEL=error
CAPACITYLENS_RATE_LIMIT=10000
CAPACITYLENS_ALLOW_RESET=true
# Tests read the real clock.
CAPACITYLENS_FIXED_TODAY=
