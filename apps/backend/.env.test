# Fixed values for the test runner, loaded when NODE_ENV=test. A variable already set in the
# shell wins over this file. Lane-computed values and values tests must not inherit stay in
# bin/test.ts. No secret belongs here; APP_KEY is the public test key.
HOST=127.0.0.1
LOG_LEVEL=error
APP_KEY=capacitylens-test-key-0123456789abcdef
