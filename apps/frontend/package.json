{
  "name": "@capacitylens/frontend",
  "version": "0.74.0-alpha.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitylens/backend": "workspace:*",
    "@capacitylens/shared": "workspace:*",
    "@tanstack/query-core": "5.105.3",
    "@tanstack/react-query": "5.105.3",
    "@tuyau/core": "1.3.0",
    "@tuyau/react-query": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.10.2",
    "lucide-react": "~1.65.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "pnpm run paraglide:compile && vite",
    "build": "pnpm run paraglide:compile && tsc -b tsconfig.build.json && vite build",
    "test": "pnpm run paraglide:compile && vitest run",
    "lint": "pnpm run paraglide:compile && eslint src vite.config.ts --max-warnings 0",
    "typecheck": "pnpm run paraglide:compile && tsc -b tsconfig.app.json tsconfig.node.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-m-function-matcher": "2.4.3",
    "@inlang/plugin-message-format": "4.5.6",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
