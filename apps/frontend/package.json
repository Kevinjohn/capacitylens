{
  "name": "@capacitylens/frontend",
  "version": "0.73.0-alpha.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitylens/backend": "workspace:*",
    "@capacitylens/shared": "workspace:*",
    "@tanstack/query-core": "5.104.2",
    "@tanstack/react-query": "5.104.2",
    "@tuyau/core": "1.2.2",
    "@tuyau/react-query": "1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "pnpm run paraglide:compile && vite",
    "build": "pnpm run paraglide:compile && tsc -b tsconfig.build.json && vite build",
    "test": "pnpm run paraglide:compile && vitest run",
    "lint": "pnpm run paraglide:compile && eslint src vite.config.ts --max-warnings 0",
    "typecheck": "pnpm run paraglide:compile && tsc -b tsconfig.app.json tsconfig.node.json",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-m-function-matcher": "2.2.16",
    "@inlang/plugin-message-format": "4.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
