{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".adonisjs/**"]
    },
    "test": { "dependsOn": ["^build"], "cache": false },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "@capacitylens/frontend#test": {
      "dependsOn": ["^build", "@capacitylens/backend#build"],
      "cache": false
    },
    "@capacitylens/frontend#lint": {
      "dependsOn": ["^build", "@capacitylens/backend#build"],
      "outputs": []
    },
    "@capacitylens/frontend#typecheck": {
      "dependsOn": ["^build", "@capacitylens/backend#build"],
      "outputs": []
    }
  }
}
