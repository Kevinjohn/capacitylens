{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".adonisjs/**"]
    },
    "test": { "dependsOn": ["^build"], "cache": false },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true }
  }
}
