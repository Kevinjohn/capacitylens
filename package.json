{
  "name": "capacitylens",
  "private": true,
  "version": "0.75.0-alpha.1",
  "description": "Agency resource & capacity scheduler — a helicopter view of who's busy, free, or overworked, week by week. Self-hosted, deliberately small.",
  "license": "GPL-3.0-or-later",
  "author": "Kevinjohn Gallagher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/capacitylens.git"
  },
  "homepage": "https://kevinjohn.github.io/capacitylens/",
  "bugs": "https://github.com/Kevinjohn/capacitylens/issues",
  "keywords": [
    "resource-scheduling",
    "capacity-planning",
    "agency",
    "scheduler",
    "self-hosted",
    "react",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25 || >=26.9.0 <27"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "prepare": "simple-git-hooks",
    "paraglide:compile": "pnpm --dir apps/frontend paraglide:compile",
    "dev": "node scripts/dev/with-lane.mjs node scripts/dev/dev-fullstack.mjs",
    "dev:web": "node scripts/dev/with-lane.mjs pnpm --dir apps/frontend dev",
    "dev:demo": "node scripts/dev/with-lane.mjs node scripts/dev/dev-demo.mjs",
    "lanes": "node scripts/dev/lanes.mjs",
    "build": "pnpm --filter @capacitylens/shared build && pnpm --dir apps/backend codegen && pnpm --dir apps/backend typecheck:client && pnpm --dir apps/frontend build && node scripts/build/sync-adonis-public.mjs && pnpm --dir apps/backend build && pnpm run check:bundle",
    "docker:release:test": "node --test scripts/release/docker/prepare-container-runtime.test.mjs scripts/release/docker/published-image-state.test.mjs",
    "packaging:release:test": "node --test packaging/release/release-files.test.mjs",
    "check:bundle": "node scripts/build/check-bundle-budget.mjs",
    "security:gitleaks-config": "node scripts/maintenance/check-gitleaks-config.mjs",
    "security:screenshot-publication": "node scripts/docs/check-screenshot-publication.mjs",
    "security:screenshot-publication:test": "node --test scripts/docs/check-screenshot-publication.test.mjs",
    "policy:ports": "node scripts/dev/check-ports.mjs",
    "policy:ports:test": "node --test scripts/dev/check-ports.test.mjs tooling/ports.test.mjs scripts/dev/laneClaims.test.mjs scripts/dev/lanes.test.mjs scripts/e2e/playwrightRunMode.test.mjs",
    "policy:dco:test": "node --test scripts/maintenance/check-dco.test.mjs",
    "policy:terminology": "node scripts/maintenance/check-terminology.mjs",
    "policy:terminology:test": "node --test scripts/maintenance/check-terminology.test.mjs tooling/terminology.test.mjs",
    "policy:release-validation:test": "node --test scripts/release/require-release-validation.test.mjs",
    "policy:script-processes:test": "node --test tooling/devProcesses.test.mjs scripts/shared/childProcess.test.mjs scripts/e2e/run-preset.test.mjs scripts/build/bundleBudget.test.mjs scripts/e2e/serve-dist.test.mjs scripts/e2e/playwrightFixturesPolicy.test.mjs",
    "check:ui": "node scripts/maintenance/check-ui-primitives.mjs",
    "ui:registry": "node scripts/maintenance/ui-registry.mjs",
    "check:push": "pnpm run check:ui && pnpm run format:check && pnpm run typecheck && pnpm run lint",
    "check:changed": "node scripts/dev/with-lane.mjs node scripts/ci/check-changed.mjs",
    "lint": "turbo lint && eslint scripts e2e tooling packages/shared/src --max-warnings 0",
    "lint:staged": "pnpm run paraglide:compile && lint-staged",
    "typecheck": "turbo typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "format": "prettier --write .",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "preview": "node scripts/dev/with-lane.mjs pnpm --dir apps/frontend exec vite preview",
    "docs:dev": "node scripts/dev/with-lane.mjs vitepress dev docs-src",
    "docs:build": "vitepress build docs-src && node scripts/docs/docs-standalone.mjs && node scripts/docs/check-docs-navigation.mjs",
    "docs:test": "CAPACITYLENS_DOCS_SITE_TESTS=1 pnpm --dir apps/frontend exec vitest run src/test/docs-lightbox.test.ts",
    "docs:preview": "node scripts/dev/with-lane.mjs vitepress preview docs-src",
    "test": "node scripts/dev/with-lane.mjs turbo test",
    "dev:api": "CAPACITYLENS_VITE_SERVICE=dbWeb pnpm --dir apps/frontend dev",
    "dev:auth": "CAPACITYLENS_VITE_SERVICE=authWeb pnpm --dir apps/frontend dev",
    "e2e": "node scripts/dev/with-lane.mjs playwright test",
    "e2e:journey": "node scripts/dev/with-lane.mjs playwright test --grep @journey",
    "e2e:webkit": "node scripts/dev/with-lane.mjs node scripts/e2e/run-preset.mjs webkit",
    "e2e:firefox": "node scripts/dev/with-lane.mjs node scripts/e2e/run-preset.mjs firefox",
    "e2e:browsers": "node scripts/dev/with-lane.mjs node scripts/e2e/e2e-browsers.mjs",
    "e2e:all": "node scripts/dev/with-lane.mjs node scripts/e2e/e2e-all.mjs",
    "check:deps": "pnpm audit --prod --no-optional --audit-level high",
    "gate": "node scripts/dev/with-lane.mjs node scripts/ci/run-gate.mjs app",
    "gate:all": "node scripts/dev/with-lane.mjs node scripts/ci/run-gate.mjs all",
    "gate:tooling": "node scripts/dev/with-lane.mjs node scripts/ci/run-gate.mjs tooling",
    "gate:static": "node scripts/dev/with-lane.mjs node scripts/ci/run-gate.mjs static",
    "check:node26": "node scripts/ci/check-node26.mjs",
    "policy:sonner-csp:test": "node --test scripts/maintenance/check-sonner-csp.test.mjs",
    "policy:gate-runner:test": "node --test scripts/ci/run-gate.test.mjs scripts/ci/pre-push.test.mjs scripts/ci/select-validation.test.mjs",
    "policy:check-changed:test": "node --test scripts/ci/check-changed.test.mjs",
    "policy:turbo-graph:test": "node --test scripts/ci/turbo-graph.test.mjs",
    "policy:node-runtime:test": "node --test scripts/ci/check-node-runtime.test.mjs",
    "policy:e2e-workers:test": "node --test --test-concurrency=1 scripts/e2e/e2eWorkerRuntime.test.mjs scripts/dev/disposableDemoStorage.test.mjs scripts/e2e/playwrightWorkers.test.mjs scripts/e2e/e2eReset.test.mjs scripts/e2e/playwright-server-reuse.test.mjs scripts/e2e/serverStateTransport.test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:staged",
    "pre-push": "node scripts/ci/pre-push.mjs"
  },
  "dependencies": {
    "@capacitylens/shared": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "~17.13.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12",
    "yaml": "2.9.1"
  }
}
