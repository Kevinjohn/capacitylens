{
  "name": "capacitylens",
  "private": true,
  "version": "0.73.0-alpha.1",
  "description": "Agency resource & capacity scheduler — a helicopter view of who's busy, free, or overworked, week by week. Self-hosted, deliberately small.",
  "license": "AGPL-3.0-only",
  "author": "Kevinjohn Gallagher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/capacitylens.git"
  },
  "homepage": "https://github.com/Kevinjohn/capacitylens#readme",
  "bugs": "https://github.com/Kevinjohn/capacitylens/issues",
  "keywords": [
    "resource-scheduling",
    "capacity-planning",
    "agency",
    "scheduler",
    "self-hosted",
    "react",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25 || >=26.9.0 <27"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "prepare": "simple-git-hooks",
    "paraglide:compile": "pnpm --dir apps/frontend paraglide:compile",
    "dev": "node scripts/with-lane.mjs node scripts/dev-fullstack.mjs",
    "dev:web": "node scripts/with-lane.mjs pnpm --dir apps/frontend dev",
    "dev:demo": "node scripts/with-lane.mjs node scripts/run-preset.mjs dev-demo",
    "lanes": "node scripts/lanes.mjs",
    "build": "pnpm --filter @capacitylens/shared build && pnpm --dir apps/backend codegen && pnpm --dir apps/backend typecheck:client && pnpm --dir apps/frontend build && node scripts/sync-adonis-public.mjs && pnpm --dir apps/backend build && pnpm run bundle:check",
    "package:managed-release": "node scripts/package-managed-release.mjs",
    "package:managed-release:test": "node --test scripts/package-managed-release.test.mjs scripts/deploy-managed-runtime.test.mjs scripts/prepare-container-runtime.test.mjs",
    "package:release-archive": "node scripts/package-managed-release.mjs --archive",
    "bundle:check": "node scripts/check-bundle-budget.mjs && node scripts/check-spa-route-documents.mjs",
    "security:gitleaks-config": "node scripts/check-gitleaks-config.mjs",
    "security:screenshot-publication": "node scripts/check-screenshot-publication.mjs",
    "security:screenshot-publication:test": "node --test scripts/check-screenshot-publication.test.mjs",
    "policy:ports": "node scripts/check-ports.mjs",
    "policy:ports:test": "node --test scripts/check-ports.test.mjs scripts/ports.test.mjs scripts/laneClaims.test.mjs scripts/lanes.test.mjs scripts/playwrightRunMode.test.mjs",
    "policy:dco:test": "node --test scripts/check-dco.test.mjs",
    "policy:workflow-report:test": "node --test scripts/report-workflow-outcome.test.mjs",
    "ui:check": "node scripts/check-ui-primitives.mjs",
    "ui:registry": "pnpm dlx shadcn@4.16.0",
    "check:push": "pnpm run format:check && pnpm run typecheck && pnpm run lint",
    "lint": "turbo lint && eslint scripts e2e packages/shared/src --max-warnings 0",
    "lint:staged": "pnpm run paraglide:compile && lint-staged",
    "typecheck": "turbo typecheck && tsc -p tsconfig.e2e.json --noEmit",
    "format": "prettier --write .",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown --no-error-on-unmatched-pattern",
    "preview": "node scripts/with-lane.mjs pnpm --dir apps/frontend exec vite preview",
    "docs:dev": "node scripts/with-lane.mjs vitepress dev docs-src",
    "docs:build": "vitepress build docs-src && node scripts/docs-standalone.mjs && node scripts/check-docs-navigation.mjs",
    "docs:navigation:test": "node scripts/check-docs-navigation.mjs",
    "docs:preview": "node scripts/with-lane.mjs vitepress preview docs-src",
    "test": "node scripts/with-lane.mjs turbo test",
    "test:watch": "pnpm run paraglide:compile && pnpm --dir apps/frontend exec vitest",
    "dev:api": "CAPACITYLENS_VITE_SERVICE=dbWeb pnpm --dir apps/frontend dev",
    "dev:auth": "CAPACITYLENS_VITE_SERVICE=authWeb pnpm --dir apps/frontend dev",
    "e2e": "node scripts/with-lane.mjs playwright test",
    "e2e:webkit": "node scripts/with-lane.mjs node scripts/run-preset.mjs webkit",
    "e2e:firefox": "node scripts/with-lane.mjs node scripts/run-preset.mjs firefox",
    "e2e:browsers": "node scripts/with-lane.mjs node scripts/e2e-browsers.mjs",
    "e2e:all": "node scripts/with-lane.mjs node scripts/e2e-all.mjs",
    "gate:deps": "pnpm audit --prod --no-optional --audit-level high",
    "gate": "node scripts/with-lane.mjs node scripts/run-gate.mjs app",
    "gate:all": "node scripts/with-lane.mjs node scripts/run-gate.mjs all",
    "mutation": "pnpm run paraglide:compile && stryker run",
    "smoke:packaged-server": "node scripts/smoke-packaged-server.mjs",
    "check:node26": "node scripts/check-node26.mjs",
    "test:server": "node scripts/with-lane.mjs pnpm --dir apps/backend test",
    "gate:server": "node scripts/with-lane.mjs node scripts/run-gate.mjs backend",
    "policy:sonner-csp:test": "node --test scripts/check-sonner-csp.test.mjs",
    "policy:gate-runner:test": "node --test scripts/run-gate.test.mjs",
    "policy:dependabot": "node scripts/check-dependabot.mjs",
    "policy:dependabot:test": "node --test scripts/check-dependabot.test.mjs",
    "policy:packaged-smoke:test": "node --test scripts/smoke-packaged-server.test.mjs",
    "policy:node-runtime:test": "node --test scripts/check-node-runtime.test.mjs scripts/check-node26.test.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint:staged",
    "pre-push": "pnpm run check:push"
  },
  "dependencies": {
    "@capacitylens/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-m-function-matcher": "2.2.16",
    "@inlang/plugin-message-format": "4.4.4",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-spawn": "7.0.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "yaml": "2.9.1"
  }
}
