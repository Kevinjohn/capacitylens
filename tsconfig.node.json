{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Filesystem tests belong to the Node project so ambient Node globals cannot enter the browser program.
  // Project membership controls type-checking; Vitest’s discovery glob still collects the tests.
  "include": [
    "vite.config.ts",
    "shared/src/packageExports.test.ts",
    "src/auth/authErrorInit.test.ts",
    "src/bundleBudgetGate.test.ts",
    "src/cryptoInventoryGate.test.ts",
    "src/data/offlineWorker.test.ts",
    "src/playwrightFixturesPolicy.test.ts",
    "src/pnpmSpawn.test.ts",
    "src/serve-dist.test.ts",
    "src/test/docs-lightbox.test.ts",
    "src/test/privacy-posture.test.ts"
  ]
}
