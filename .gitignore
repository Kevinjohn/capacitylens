*.db-wal
*.db-shm
server/.auth-e2e-mailbox.jsonl
# Server audit logs are runtime artifacts written beside the database.
*-audit.jsonl

# Repository-local tool scratch can appear in any clone.
# Ignore these exact directories so broader patterns do not hide project files.
/.playwright-mcp/
/.issue-fix-state/
*-state.json
